
name: Deploy with GHA

on:
    push:
         branches:
          - main 	
    workflow_dispatch:
env:
    artifact_version: 1.0
permissions:
      id-token: write
      contents: read

jobs:
  build:
  outputs:
      # Map the step's output to a job output
      artifact-id: ${{ steps.register.outputs.artifact-id }} #
    runs-on: ubuntu-latest
    steps:
      - name: Compile Code
        run: echo "Compiling..."

      - name: Add Health Check Feature
        run: echo "Integration health check endpoint calls to backend ..."

      - name: Produce Binary
        run: sleep 5

      - name: Push binary
        run: echo "Pushing Binary to ECR..."

      - name: Register Build Artifacts in Cloudbees Platform
        uses: cloudbees-io-gha/register-build-artifact@v3
        id: register
        with:
          name: "GHA-Artifact"
          version: ${{ env.artifact_version }}
          url: docker.io/MyApp/Frontend-GHA:${{ env.artifact_version }}
          type: "docker"
          
      - name: Publish evidence
        uses: cloudbees-io-gha/publish-evidence-item@v2
        with:
          content: |-
            Build completed and artifacts published to CloudBees platform
  deploy-preprod:
      needs: build
      environment: pre-prod
      steps:
        - name: Register deployed artifact
          uses: cloudbees-io/register-deployed-artifact@v2
          with:
            artifact-id: ${{ needs.build.outputs.artifact-id }}
  deploy-qa:
      needs: 
        - build
        - deploy-preprod
      environment: qa
      steps:
        - name: Register deployed artifact
          uses: cloudbees-io/register-deployed-artifact@v2
          with:
            artifact-id: ${{ needs.build.outputs.artifact-id }}
